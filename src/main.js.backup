const dateElement = document.querySelector('#today-date')

dateElement.textContent = new Intl.DateTimeFormat('ar-DZ', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date())

const taskForm = document.querySelector('#task-form')
const taskInput = document.querySelector('#task-input')
const taskList = document.querySelector('#task-list')
const taskCount = document.querySelector('#task-count')
const taskFeedback = document.querySelector('#task-feedback')
const completedStat = document.querySelector('#completed-stat')
const tasksStatNote = document.querySelector('#tasks-stat-note')
const totalTasksStat = document.querySelector('#total-tasks-stat')


function saveTasks() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks))
    return true
  } catch {
    taskFeedback.textContent = 'تعذّر حفظ التغييرات في المتصفح.'
    return false
  }
}

function syncTaskWithStages(taskId, updates = null) {
  const stages = getStages()
  let changed = false

  stages.forEach((stage) => {
    const stageTask = stage.tasks.find((task) => task.id === taskId)

    if (!stageTask) return

    if (updates === null) {
      stage.tasks = stage.tasks.filter((task) => task.id !== taskId)
      changed = true
      return
    }

    if (typeof updates.title === 'string') {
      stageTask.title = updates.title
      changed = true
    }

    if (typeof updates.completed === 'boolean') {
      stageTask.completed = updates.completed
      changed = true
    }
  })

  // إذا كانت المهمة جديدة، أضفها إلى المرحلة الأولى.
  if (updates && !stages.some((stage) =>
    stage.tasks.some((task) => task.id === taskId)
  )) {
    const firstStage = stages[0]

    if (firstStage && !firstStage.completed) {
      firstStage.tasks.push({
        id: taskId,
        title: updates.title,
        completed: Boolean(updates.completed),
      })
      changed = true
    }
  }

  if (changed) saveStages(stages)
}


function renderTasks() {
  taskList.replaceChildren()

 
const dailyCompleted = tasks.filter((task) => task.completed).length
const dailyTotal = tasks.length

const scheduleTasks = getDailyTasks(getTodayKey())
const scheduleCompleted = scheduleTasks.filter((task) => task.completed).length
const scheduleTotal = scheduleTasks.length

const completed = dailyCompleted + scheduleCompleted
const total = dailyTotal + scheduleTotal
const percentage = total === 0 ? 0 : Math.round((completed / total) * 100)

  taskCount.textContent = `${dailyCompleted} / ${dailyTotal}`
totalTasksStat.textContent = `إجمالي المهام اليوم: ${total} — المكتملة: ${completed} (${percentage}%)`
  completedStat.innerHTML = `${completed} <small>مهمة</small>`
tasksStatNote.textContent =
  total === 0
    ? 'ابدأ بأول إنجاز لك'
    : `أنجزت ${completed} من ${total} مهمة في النظامين`


  if (dailyTotal === 0) {
    const empty = document.createElement('div')
    empty.className = 'empty-tasks'

    const icon = document.createElement('span')
    icon.className = 'empty-icon'
    icon.textContent = '✓'


    const title = document.createElement('strong')
    title.textContent = 'مساحة إنجازاتك جاهزة'

    const description = document.createElement('p')
    description.textContent = 'أضف أول مهمة وابدأ التقدم.'

    empty.append(icon, title, description)
    taskList.append(empty)
    return
  }

  tasks.forEach((task) => {
    const row = document.createElement('div')
    row.className = 'task-row'
    if (task.completed) row.classList.add('is-completed')

    const label = document.createElement('label')
    label.className = 'task-label'

    const checkbox = document.createElement('input')
    checkbox.type = 'checkbox'
    checkbox.checked = task.completed
    checkbox.setAttribute('aria-label', `إنجاز المهمة: ${task.title}`)

    
checkbox.addEventListener('change', () => {
 task.completed = checkbox.checked
 task.completedAt = task.completed ? new Date().toISOString() : null 

  if (saveTasks()) {
    syncTaskWithStages(task.id, {
      title: task.title,
      completed: task.completed,
    })

    renderTasks()
    renderStages()
    renderAchievements()
  }
})


    const title = document.createElement('span')
    title.className = 'task-title'
    title.textContent = task.title

    label.append(checkbox, title)

    const deleteButton = document.createElement('button')
    deleteButton.type = 'button'
    deleteButton.className = 'task-delete'
    deleteButton.textContent = 'حذف'
    deleteButton.setAttribute('aria-label', `حذف المهمة: ${task.title}`)

    
deleteButton.addEventListener('click', () => {
  tasks = tasks.filter((item) => item.id !== task.id)

  if (!saveTasks()) {
    tasks = loadTasks()
    renderTasks()
    return
  }

  syncTaskWithStages(task.id, null)

  taskFeedback.textContent = 'تم حذف المهمة.'
  renderTasks()
  renderStages()
})


    row.append(label, deleteButton)
    taskList.append(row)
  })
}

taskForm.addEventListener('submit', (event) => {
  event.preventDefault()

  const title = taskInput.value.trim()

  if (!title) {
    taskFeedback.textContent = 'اكتب اسم المهمة أولًا.'
    taskInput.focus()
    return
  }

  
  const newTask = {
  id: crypto.randomUUID(),
  title,
  completed: false,
  createdAt: new Date().toISOString(),
  completedAt: null,
}

tasks.push(newTask)


  if (!saveTasks()) {
    tasks.pop()
    return
  }

  
syncTaskWithStages(newTask.id, {
  title: newTask.title,
  completed: newTask.completed,
})

taskForm.reset()
taskFeedback.textContent = 'تمت إضافة المهمة وحفظها.'
renderTasks()
renderStages()
renderAchievements()
})

renderTasks()

const scheduleDate = document.querySelector('#schedule-date')
const scheduleForm = document.querySelector('#schedule-form')
const scheduleTitle = document.querySelector('#schedule-task-title')
const scheduleStart = document.querySelector('#schedule-start')
const scheduleEnd = document.querySelector('#schedule-end')
const scheduleTimeline = document.querySelector('#schedule-timeline')
const scheduleFeedback = document.querySelector('#schedule-feedback')
const scheduleTaskCount = document.querySelector('#schedule-task-count')
const schedulePlannedTime = document.querySelector('#schedule-planned-time')
const scheduleCompletion = document.querySelector('#schedule-completion')
const scheduleRemainingCount = document.querySelector('#schedule-remaining-count')
const scheduleRemainingTime = document.querySelector('#schedule-remaining-time')

function getTodayKey() {
  const now = new Date()
  const year = now.getFullYear()
  const month = String(now.getMonth() + 1).padStart(2, '0')
  const day = String(now.getDate()).padStart(2, '0')

  return `${year}-${month}-${day}`
}

scheduleDate.value = getTodayKey()

function formatDuration(minutes) {
  const hours = Math.floor(minutes / 60)
  const remainingMinutes = minutes % 60

  if (hours && remainingMinutes) {
    return `${hours} س ${remainingMinutes} د`
  }

  if (hours) return `${hours} ساعة`
  return `${remainingMinutes} دقيقة`
}


function getCurrentTimePosition(tasks) {
  const now = new Date()
  const currentMinutes = now.getHours() * 60 + now.getMinutes()

  const currentTask = tasks.find((task) => {
    const start =
      Number(task.start.slice(0, 2)) * 60 +
      Number(task.start.slice(3, 5))

    const end =
      Number(task.end.slice(0, 2)) * 60 +
      Number(task.end.slice(3, 5))

    return currentMinutes >= start && currentMinutes < end
  })

  return {
    currentMinutes,
    currentTaskId: currentTask?.id ?? null,
  }
}


function renderSchedule() {
  const date = scheduleDate.value
  const tasks = getDailyTasks(date)
  const stats = getDailyScheduleStats(date)
  const commitmentDaysStat = document.querySelector(
  '#commitment-days-stat',
)

if (commitmentDaysStat) {
  commitmentDaysStat.innerHTML =
    `${getDailyCommitmentStats()} <small>يوم</small>`
} 
  const pendingTasks = tasks.filter((task) => !task.completed)

const remainingMinutes = pendingTasks.reduce((total, task) => {
  const start =
    Number(task.start.slice(0, 2)) * 60 +
    Number(task.start.slice(3, 5))

  const end =
    Number(task.end.slice(0, 2)) * 60 +
    Number(task.end.slice(3, 5))

  return total + (end - start)
}, 0)
  const currentPosition = getCurrentTimePosition(tasks)

  scheduleTaskCount.textContent = stats.totalTasks
  schedulePlannedTime.textContent = formatDuration(stats.plannedMinutes)
  scheduleCompletion.textContent = `${stats.completionRate}%`
  scheduleRemainingCount.textContent = pendingTasks.length
scheduleRemainingTime.textContent = formatDuration(remainingMinutes)

const progressLabel = document.querySelector('#daily-progress-label')
const progressTrack = document.querySelector('#daily-progress-track')
const progressFill = document.querySelector('#daily-progress-fill')

progressLabel.textContent = `${stats.completionRate}%`
progressTrack.setAttribute('aria-valuenow', stats.completionRate)
progressFill.style.width = `${stats.completionRate}%`

  scheduleTimeline.replaceChildren()

  if (tasks.length === 0) {
    const empty = document.createElement('div')
    empty.className = 'empty-tasks'

    const title = document.createElement('strong')
    title.textContent = 'لا توجد مهام في هذا اليوم'

    const description = document.createElement('p')
    description.textContent = 'أضف مهمتك الأولى وحدد وقت بدايتها ونهايتها.'

    empty.append(title, description)
    scheduleTimeline.append(empty)
    return
  }

  tasks.forEach((task) => {
    const row = document.createElement('article')
    row.className = 'schedule-item'

    if (task.completed) row.classList.add('is-completed')
      if (task.id === currentPosition.currentTaskId && !task.completed) {
  row.classList.add('is-current')
}

    const time = document.createElement('div')
    time.className = 'schedule-time'

    const start = document.createElement('strong')
    start.textContent = task.start

    const separator = document.createElement('span')
    separator.textContent = '↓'

    const end = document.createElement('span')
    end.textContent = task.end

    time.append(start, separator, end)

    const marker = document.createElement('span')
    marker.className = 'schedule-marker'
    marker.setAttribute('aria-hidden', 'true')

    const details = document.createElement('div')
    details.className = 'schedule-details'

    const title = document.createElement('strong')
    title.className = 'schedule-title'
    title.textContent = task.title
    if (task.id === currentPosition.currentTaskId && !task.completed) {
  const badge = document.createElement('span')
  badge.className = 'current-task-badge'
  badge.textContent = 'جارية الآن'
  details.append(badge)
}

    const duration = document.createElement('span')
    duration.className = 'schedule-duration'

    const minutes =
      Number(task.end.slice(0, 2)) * 60 +
      Number(task.end.slice(3, 5)) -
      Number(task.start.slice(0, 2)) * 60 -
      Number(task.start.slice(3, 5))

    duration.textContent = formatDuration(minutes)

    details.append(title, duration)

    const actions = document.createElement('div')
    actions.className = 'schedule-actions'

    const completeLabel = document.createElement('label')
    completeLabel.className = 'schedule-check'

    const checkbox = document.createElement('input')
    checkbox.type = 'checkbox'
    checkbox.checked = task.completed
    checkbox.setAttribute('aria-label', `إنجاز ${task.title}`)

    const checkText = document.createElement('span')
    checkText.textContent = 'تم'

    checkbox.addEventListener('change', () => {
      try {
        setDailyTaskCompleted(task.id, checkbox.checked, date)
        scheduleFeedback.textContent = checkbox.checked
          ? 'أُنجزت المهمة بنجاح.'
          : 'أُعيد فتح المهمة.'
        renderSchedule()
      } catch (error) {
        scheduleFeedback.textContent = error.message
      }
    })

    completeLabel.append(checkbox, checkText)

    const deleteButton = document.createElement('button')
    deleteButton.type = 'button'
    deleteButton.className = 'task-delete'
    deleteButton.textContent = 'حذف'
    deleteButton.setAttribute('aria-label', `حذف ${task.title}`)

    deleteButton.addEventListener('click', () => {
      try {
        deleteDailyTask(task.id, date)
        scheduleFeedback.textContent = 'تم حذف المهمة.'
        renderSchedule()
      } catch (error) {
        scheduleFeedback.textContent = error.message
      }
    })

    actions.append(completeLabel, deleteButton)
    row.append(time, marker, details, actions)
    scheduleTimeline.append(row)
  })
}

scheduleForm.addEventListener('submit', (event) => {
  event.preventDefault()

  try {
    addDailyTask({
      date: scheduleDate.value,
      title: scheduleTitle.value,
      start: scheduleStart.value,
      end: scheduleEnd.value,
    })

    scheduleFeedback.textContent = 'تمت إضافة المهمة وحفظها.'
    scheduleTitle.value = ''
    renderSchedule()
    scheduleTitle.focus()
  } catch (error) {
    scheduleFeedback.textContent = error.message
  }
})

scheduleDate.addEventListener('change', () => {
  scheduleFeedback.textContent = ''
  renderSchedule()
})

renderSchedule()


let scheduleRefreshTimer = null

function startScheduleAutoRefresh() {
  if (scheduleRefreshTimer !== null) {
    clearInterval(scheduleRefreshTimer)
  }

  scheduleRefreshTimer = setInterval(() => {
    renderSchedule()
  }, 60 * 1000)
}

startScheduleAutoRefresh()

const stageTitle = document.querySelector('#stage-title')
const stageNumber = document.querySelector('#stage-number')
const stageDescription = document.querySelector('#stage-description')
const stageTaskList = document.querySelector('#stage-task-list')
const stageProgressPercent = document.querySelector('#stage-progress-percent')
const stageProgressFill = document.querySelector('#stage-progress-fill')
const stageEvidenceFile = document.querySelector('#stage-evidence-file')
const stageEvidenceStatus = document.querySelector('#stage-evidence-status')
const stageStatus = document.querySelector('#stage-status')
const approveStageButton = document.querySelector('#approve-stage-button')

let selectedStageId = null

function renderStages() {
  let stages = getStages()

    const completedStagesCount = stages.filter(
    (stage) => stage.completed,
  ).length

  const completedStagesStat = document.querySelector(
    '#completed-stages-stat',
  )

  if (completedStagesStat) {
    completedStagesStat.innerHTML =
      `${completedStagesCount} <small>مرحلة</small>`
  }

  const currentIndex = stages.findIndex(
    (stage) => stage.unlocked && !stage.completed,
  )

  if (currentIndex === -1) {
    stageTitle.textContent = 'اكتملت جميع المراحل'
    stageNumber.textContent = '✓'
    stageDescription.textContent = 'أحسنت، لقد أنهيت جميع المراحل المتاحة.'
    stageTaskList.replaceChildren()
    stageProgressPercent.textContent = '100%'
    stageProgressFill.style.width = '100%'
    stageStatus.textContent = 'جميع المراحل مكتملة'
    stageEvidenceStatus.textContent = 'اكتملت الرحلة الحالية.'
    stageEvidenceFile.disabled = true
    approveStageButton.disabled = true
    return
  }

  let stage = stages[currentIndex]
  selectedStageId = stage.id

  // إذا كانت المرحلة بلا مهام، استخدم المهام اليومية لإنشاء قائمة أولية.
  if (stage.tasks.length === 0) {
    const dailyTasks = loadTasks()

    if (dailyTasks.length > 0) {
      stage.tasks = dailyTasks.map((task) => ({
        id: task.id,
        title: task.title,
        completed: task.completed,
      }))

      saveStages(stages)
    }
  }

  const completedCount = stage.tasks.filter(
    (task) => task.completed,
  ).length

  const percentage = stage.tasks.length
    ? Math.round((completedCount / stage.tasks.length) * 100)
    : 0

  stageTitle.textContent = stage.title
  stageNumber.textContent = String(currentIndex + 1).padStart(2, '0')
  stageDescription.textContent = stage.description
  stageProgressPercent.textContent = `${percentage}%`
  stageProgressFill.style.width = `${percentage}%`

  stageTaskList.replaceChildren()

  if (stage.tasks.length === 0) {
    const message = document.createElement('p')
    message.textContent =
      'أضف مهمة واحدة على الأقل في قسم المهام اليومية، ثم أعد تحميل الصفحة.'
    stageTaskList.append(message)
  }

  stage.tasks.forEach((task) => {
    const label = document.createElement('label')
    label.className = 'task-label'

    const checkbox = document.createElement('input')
    checkbox.type = 'checkbox'
    checkbox.checked = task.completed
    checkbox.setAttribute('aria-label', `إنجاز ${task.title}`)

    const title = document.createElement('span')
    title.className = 'task-title'
    title.textContent = task.title

    
function syncTaskWithStages(taskId, updates = null) {
  const stages = getStages()
  let changed = false

  stages.forEach((stage) => {
    // لا نغيّر سجل أي مرحلة مكتملة.
    if (stage.completed) return

    const taskIndex = stage.tasks.findIndex(
      (task) => task.id === taskId,
    )

    if (taskIndex === -1) return

    if (updates === null) {
      stage.tasks.splice(taskIndex, 1)
      changed = true
      return
    }

    const stageTask = stage.tasks[taskIndex]

    if (typeof updates.title === 'string') {
      stageTask.title = updates.title
      changed = true
    }

    if (typeof updates.completed === 'boolean') {
      stageTask.completed = updates.completed
      changed = true
    }
  })

  // أضف المهمة إلى المرحلة الأولى فقط إذا كانت غير مكتملة.
  const firstStage = stages[0]

  if (
    updates &&
    firstStage &&
    !firstStage.completed &&
    !firstStage.tasks.some((task) => task.id === taskId)
  ) {
    firstStage.tasks.push({
      id: taskId,
      title: updates.title,
      completed: Boolean(updates.completed),
    })

    changed = true
  }

  if (changed) {
    saveStages(stages)
  }
}


    label.append(checkbox, title)
    stageTaskList.append(label)
  })

  stageEvidenceFile.disabled = stage.completed
  stageEvidenceFile.value = ''

  if (stage.evidence) {
    stageEvidenceStatus.textContent =
      `الدليل المرفق: ${stage.evidence.name}`
  } else {
    stageEvidenceStatus.textContent = 'لم يُرفق دليل بعد.'
  }

  stageStatus.textContent = stage.completed
    ? 'المرحلة مكتملة'
    : stage.unlocked
      ? 'المرحلة مفتوحة'
      : 'المرحلة مقفلة'

  approveStageButton.disabled =
    stage.completed ||
    stage.tasks.length === 0 ||
    !stage.tasks.every((task) => task.completed) ||
    !stage.evidence

  approveStageButton.textContent = stage.completed
    ? 'تم اعتماد المرحلة'
    : 'اعتماد الدليل وفتح المرحلة التالية'
}

stageEvidenceFile.addEventListener('change', async () => {
  const file = stageEvidenceFile.files?.[0]

  if (!file || !selectedStageId) return

  if (file.size > 25 * 1024 * 1024) {
    stageEvidenceStatus.textContent =
      'حجم الملف يتجاوز الحد المسموح به (25 ميغابايت).'
    stageEvidenceFile.value = ''
    return
  }

  stageEvidenceStatus.textContent = 'جارٍ حفظ الدليل...'
  stageEvidenceFile.disabled = true

  try {
    const evidence = await saveEvidenceFile(file)
    const stages = getStages()
    const stage = stages.find((item) => item.id === selectedStageId)

    if (!stage) {
      stageEvidenceStatus.textContent = 'لم يتم العثور على المرحلة.'
      return
    }

    stage.evidence = evidence
    saveStages(stages)
    renderStages()
    stageEvidenceStatus.textContent = `تم حفظ الدليل: ${file.name}`
  } catch (error) {
    stageEvidenceStatus.textContent =
      `تعذّر حفظ الدليل: ${error.message || 'خطأ غير معروف'}`
  } finally {
    stageEvidenceFile.disabled = false
  }
})

approveStageButton.addEventListener('click', () => {
  if (!selectedStageId) return

  try {
    approveStageEvidence(selectedStageId)
    renderStages()
    renderAchievements()
    stageEvidenceStatus.textContent =
      'تم اعتماد الدليل وفتح المرحلة التالية.'
  } catch (error) {
    stageEvidenceStatus.textContent = error.message
  }
})

renderStages()
function renderAchievements() {
  const list = document.querySelector('#achievements-list')
  const tasksCount = document.querySelector('#achievement-tasks-count')
  const stagesCount = document.querySelector('#achievement-stages-count')

  if (!list || !tasksCount || !stagesCount) return

  const completedTasks = tasks.filter((task) => task.completed)
  const completedStages = getStages().filter((stage) => stage.completed)

  tasksCount.textContent = String(completedTasks.length)
  stagesCount.textContent = String(completedStages.length)

  list.replaceChildren()

  const achievements = [
    ...completedTasks.map((task) => ({
      title: task.title,
      type: 'مهمة مكتملة',
      date: task.completedAt,
    })),
    ...completedStages.map((stage) => ({
      title: stage.title,
      type: 'مرحلة مكتملة',
      date: stage.completedAt,
    })),
  ]

  achievements.sort((a, b) => {
    const dateA = a.date ? new Date(a.date).getTime() : 0
    const dateB = b.date ? new Date(b.date).getTime() : 0
    return dateB - dateA
  })

  if (achievements.length === 0) {
    const empty = document.createElement('p')
    empty.className = 'empty-tasks'
    empty.textContent = 'لم تسجل إنجازات بعد. ابدأ بإكمال أول مهمة!'
    list.append(empty)
    return
  }

  achievements.forEach((achievement) => {
    const row = document.createElement('article')
    row.className = 'task-row'

    const content = document.createElement('div')
    content.className = 'task-label'

    const title = document.createElement('strong')
    title.className = 'task-title'
    title.textContent = achievement.title

    const details = document.createElement('p')
    details.className = 'stat-note'

    if (achievement.date && !Number.isNaN(Date.parse(achievement.date))) {
      details.textContent =
        `${achievement.type} — ${new Intl.DateTimeFormat('ar-DZ', {
          dateStyle: 'medium',
          timeStyle: 'short',
        }).format(new Date(achievement.date))}`
    } else {
      details.textContent = `${achievement.type} — تاريخ الإنجاز غير متوفر`
    }

    content.append(title, details)
    row.append(content)
    list.append(row)
  })
}

const exportBackupButton = document.querySelector('#export-backup-button')
const importBackupFile = document.querySelector('#import-backup-file')
const backupFeedback = document.querySelector('#backup-feedback')

exportBackupButton.addEventListener('click', async () => {
  exportBackupButton.disabled = true
  backupFeedback.textContent = 'جارٍ تجهيز النسخة الاحتياطية...'

  try {
    const result = await exportBackup()

    backupFeedback.textContent =
      `تم تصدير النسخة بنجاح. عدد ملفات الأدلة: ${result.evidenceCount}.`
  } catch (error) {
    backupFeedback.textContent =
      `تعذّر إنشاء النسخة: ${error.message || 'خطأ غير معروف.'}`
  } finally {
    exportBackupButton.disabled = false
  }
})

importBackupFile.addEventListener('change', async () => {
  const file = importBackupFile.files?.[0]
  if (!file) return

  const confirmed = window.confirm(
    'تحذير: ستُستبدل بيانات ASCEND الحالية بالبيانات الموجودة في النسخة الاحتياطية. تأكد من تصدير نسخة حديثة من بياناتك الحالية قبل المتابعة. هل تريد الاستمرار؟',
  )

  if (!confirmed) {
    importBackupFile.value = ''
    return
  }

  importBackupFile.disabled = true
  backupFeedback.textContent = 'جارٍ التحقق من النسخة واستعادتها...'

  try {
    const result = await importBackup(file)

    backupFeedback.textContent =
      `تمت الاستعادة. المهام: ${result.taskCount}، المراحل: ${result.stageCount}، ملفات الأدلة: ${result.evidenceCount}. سيتم تحديث التطبيق.`

    window.setTimeout(() => window.location.reload(), 1200)
  } catch (error) {
    backupFeedback.textContent =
      `تعذّرت الاستعادة: ${error.message || 'خطأ غير معروف.'}`
  } finally {
    importBackupFile.disabled = false
    importBackupFile.value = ''
  }
})

const REWARDS_KEY = 'ascend-rewards'

const rewardForm = document.querySelector('#reward-form')
const rewardTitle = document.querySelector('#reward-title')
const rewardBudget = document.querySelector('#reward-budget')
const rewardCondition = document.querySelector('#reward-condition')
const rewardFeedback = document.querySelector('#reward-feedback')
const rewardList = document.querySelector('#reward-list')
const rewardCount = document.querySelector('#reward-count')
const rewardAchievedCount = document.querySelector('#reward-achieved-count')
const rewardTotalBudget = document.querySelector('#reward-total-budget')

function loadRewards() {
  try {
    const saved = JSON.parse(localStorage.getItem(REWARDS_KEY) || '[]')
    return Array.isArray(saved) ? saved.filter(
      (reward) =>
        reward &&
        typeof reward.id === 'string' &&
        typeof reward.title === 'string' &&
        typeof reward.condition === 'string' &&
        Number.isFinite(reward.budget) &&
        typeof reward.achieved === 'boolean',
    ) : []
  } catch {
    return []
  }
}

let rewards = loadRewards()

function saveRewards() {
  try {
    localStorage.setItem(REWARDS_KEY, JSON.stringify(rewards))
    return true
  } catch {
    rewardFeedback.textContent = 'تعذّر حفظ المكافآت في المتصفح.'
    return false
  }
}

function renderRewards() {
  rewardCount.textContent = String(rewards.length)

  const achievedRewards = rewards.filter(
  (reward) => reward.achieved,
).length

rewardAchievedCount.textContent = String(achievedRewards)

const achievedRewardsStat = document.querySelector(
  '#achieved-rewards-stat',
)

if (achievedRewardsStat) {
  achievedRewardsStat.innerHTML =
    `${achievedRewards} <small>مكافأة</small>`
}

  const totalBudget = rewards.reduce(
    (sum, reward) => sum + reward.budget,
    0,
  )

  rewardTotalBudget.textContent =
    `${new Intl.NumberFormat('ar-DZ').format(totalBudget)} دج`

  rewardList.replaceChildren()

  if (rewards.length === 0) {
    const emptyMessage = document.createElement('p')
    emptyMessage.className = 'task-empty'
    emptyMessage.textContent = 'لم تضف أي مكافأة بعد. ابدأ بتحديد أول مكافأة تستحقها.'
    rewardList.append(emptyMessage)
    return
  }

  rewards.forEach((reward) => {
    const card = document.createElement('article')
    card.className = 'task-item reward-item'

    const details = document.createElement('div')
    details.className = 'task-item-content'

    const title = document.createElement('strong')
    title.textContent = reward.title

    const condition = document.createElement('p')
    condition.textContent = `شرط الاستحقاق: ${reward.condition}`

    const budget = document.createElement('p')
    budget.textContent =
      `الميزانية: ${new Intl.NumberFormat('ar-DZ').format(reward.budget)} دج`

    const status = document.createElement('p')
    status.className = 'stat-note'
    status.textContent = reward.achieved
      ? '✓ تم تحقيق المكافأة'
      : '◷ لم تتحقق بعد'

    details.append(title, condition, budget, status)

    const actions = document.createElement('div')
    actions.className = 'reward-actions'

    const toggleButton = document.createElement('button')
    toggleButton.type = 'button'
    toggleButton.className = 'primary-button'
    toggleButton.textContent = reward.achieved
      ? 'إلغاء التحقيق'
      : 'تحقيق المكافأة'

    toggleButton.addEventListener('click', () => {
      const previous = reward.achieved
      reward.achieved = !previous

      if (!saveRewards()) {
        reward.achieved = previous
        return
      }

      rewardFeedback.textContent = reward.achieved
        ? 'مبارك! تم تسجيل تحقيق المكافأة.'
        : 'تمت إعادة المكافأة إلى قائمة غير المحققة.'

      renderRewards()
    })

    const deleteButton = document.createElement('button')
    deleteButton.type = 'button'
    deleteButton.className = 'task-delete'
    deleteButton.textContent = 'حذف'

    deleteButton.addEventListener('click', () => {
      if (!window.confirm(`هل تريد حذف المكافأة «${reward.title}»؟`)) {
        return
      }

      const previousRewards = rewards
      rewards = rewards.filter((item) => item.id !== reward.id)

      if (!saveRewards()) {
        rewards = previousRewards
        return
      }

      rewardFeedback.textContent = 'تم حذف المكافأة.'
      renderRewards()
    })

    actions.append(toggleButton, deleteButton)
    card.append(details, actions)
    rewardList.append(card)
  })
}

rewardForm.addEventListener('submit', (event) => {
  event.preventDefault()

  const title = rewardTitle.value.trim()
  const condition = rewardCondition.value.trim()
  const budget = Number(rewardBudget.value)

  if (!title || !condition || !Number.isSafeInteger(budget) || budget < 0) {
    rewardFeedback.textContent = 'أدخل اسم المكافأة وشرطها وميزانية صحيحة.'
    return
  }

  const reward = {
    id: crypto.randomUUID(),
    title,
    condition,
    budget,
    achieved: false,
    createdAt: new Date().toISOString(),
  }

  rewards.push(reward)

  if (!saveRewards()) {
    rewards.pop()
    return
  }

  rewardForm.reset()
  rewardFeedback.textContent = 'تمت إضافة المكافأة وحفظها.'
  renderRewards()
})

renderRewards()
renderAchievements()

