const STORAGE_KEY = 'ascend-daily-tasks'

function loadTasks() {
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]')

    if (!Array.isArray(saved)) return []

    return saved.filter(
      (task) =>
        task &&
        typeof task.id === 'string' &&
        typeof task.title === 'string' &&
        typeof task.completed === 'boolean',
    )
  } catch {
    return []
  }
}

let tasks = loadTasks()

